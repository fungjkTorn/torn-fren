[Unit]
Description=Torn Fren private shadow research capture (single tick)
After=network.target torn-fren-web.service
ConditionPathExists=/etc/torn-fren/private-shadow.env

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/torn-fren
EnvironmentFile=/etc/torn-fren/private-shadow.env
StateDirectory=torn-fren-shadow
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
TimeoutStartSec=275
# V35 pilot: exact V18 champion Heather/Wolverine plus baseline-only Nessie/Xanax.\n# Four sequential calls, bounded by 275s, never changing player-facing forecasts.
ExecStart=/usr/bin/python3 -m research.v33_private_shadow_sampler --evidence-db /var/lib/torn-fren-shadow/capture.db --experiment pilot-museum-japan-v35 --item "uni:Heather" --item "can:Wolverine Plushie" --item "uni:Nessie Plushie" --item "jap:Xanax"
