[Unit]
Description=Run Torn Fren private shadow evidence capture every five minutes

[Timer]
# :01, :06, :11 ... :56 past each hour; avoids the five-minute tick boundary.
OnCalendar=*-*-* *:01/5:00
AccuracySec=5s
RandomizedDelaySec=0
Persistent=false
Unit=torn-fren-shadow-capture.service

[Install]
WantedBy=timers.target
