[Unit]
Description=Torn Fren V160 private, prospective 24-item V151 paired and independent research only
After=local-fs.target
ConditionPathExists=/opt/torn-fren/data/stock_history.db
ConditionPathExists=/home/ubuntu/torn-fren-private-models/v160_stage/pinned/v160_forward_shadow_launcher.py

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/torn-fren-v38-probe
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/usr/bin/flock -n /var/lib/torn-fren-v38/v160_forward24.lock /home/ubuntu/torn-fren-v38-probe/.venv/bin/python /home/ubuntu/torn-fren-private-models/v160_stage/pinned/v160_forward_shadow_launcher.py --record
Nice=19
IOSchedulingClass=idle
CPUQuota=30%
MemoryMax=512M
TimeoutStartSec=150
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/opt/torn-fren/data
ReadWritePaths=/var/lib/torn-fren-v38
UMask=0077
TasksMax=24
